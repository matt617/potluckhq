{
  "name": "potluck",
  "private": true,
  "version": "0.1.0",
  "description": "Serverless social-video-to-recipe app for small food communities",
  "workspaces": [
    "packages/core",
    "packages/functions",
    "packages/web",
    "infra"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build:web": "npm run build -w @potluck/web",
    "dev:web": "npm run dev -w @potluck/web --",
    "fetch:ytdlp": "bash scripts/fetch-ytdlp.sh",
    "synth": "npm run synth -w @potluck/infra",
    "deploy": "bash scripts/deploy.sh",
    "test:kitchens:browser": "node scripts/kitchen-browser-check.mjs",
    "build:kitchen-migration": "esbuild scripts/migrate-kitchens.ts --bundle --platform=node --format=esm --external:@aws-sdk/* --outfile=artifacts/migrate-kitchens.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "test:visual:update": "node scripts/visual-check.mjs --update"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^24.19.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
